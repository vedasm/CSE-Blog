# Never commit a populated .env file.
SECRET_KEY=replace-with-a-64-character-django-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DATABASE_URL=postgres://postgres.your-project-ref:replace-with-a-strong-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://postgres.your-project-ref:replace-with-a-strong-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db.your-project-ref.supabase.co
REDIS_URL=redis://redis:6379/0
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=cse@valliammai.ac.in
EMAIL_HOST_PASSWORD=replace-with-an-app-password
CONTACT_NOTIFY_EMAIL=hod.cse@valliammai.ac.in
DEFAULT_FROM_EMAIL=CSE Blog <cse@valliammai.ac.in>
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
JWT_SECRET_KEY=replace-with-a-separate-64-character-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# WebPush VAPID Configuration
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_ADMIN_EMAIL=admin@valliammai.ac.in
